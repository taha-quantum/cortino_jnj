# Set these in your shell: nothing loads this file automatically.

# LLM provider: "anthropic" (default), "vertex" (Claude on Vertex AI) or "gemini" (Gemini on Vertex AI)
CORTINO_LLM_PROVIDER=anthropic

# anthropic: API key
ANTHROPIC_API_KEY=

# vertex: `gcloud auth application-default login`, enable the Claude models in Model Garden,
# `uv sync --extra vertex`
CLOUD_ML_REGION=
ANTHROPIC_VERTEX_PROJECT_ID=

# gemini: `gcloud auth application-default login`, `uv sync --extra gemini`.
# Falls back to ANTHROPIC_VERTEX_PROJECT_ID / CLOUD_ML_REGION; location defaults to "global".
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Optional: the DuckDB warehouse file, instead of warehouse.path in config/sources.yaml
CORTINO_WAREHOUSE_PATH=
