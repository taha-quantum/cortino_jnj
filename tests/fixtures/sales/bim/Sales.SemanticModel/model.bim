{
  "name": "Sales",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Sales",
        "columns": [
          {
            "name": "order_id",
            "dataType": "int64",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "order_date",
            "dataType": "dateTime",
            "sourceColumn": "order_date",
            "summarizeBy": "none"
          },
          {
            "name": "customer_id",
            "dataType": "int64",
            "sourceColumn": "customer_id",
            "summarizeBy": "none"
          },
          {
            "name": "product_id",
            "dataType": "int64",
            "sourceColumn": "product_id",
            "summarizeBy": "none"
          },
          {
            "name": "quantity",
            "dataType": "int64",
            "sourceColumn": "quantity",
            "summarizeBy": "sum"
          },
          {
            "name": "amount",
            "dataType": "decimal",
            "sourceColumn": "amount",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"server01\", \"salesdb\"),",
                "    dbo_Sales = Source{[Schema=\"dbo\",Item=\"Sales\"]}[Data]",
                "in",
                "    dbo_Sales"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Sales",
            "expression": "SUM(Sales[amount])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00"
          },
          {
            "name": "Order Count",
            "expression": "DISTINCTCOUNT(Sales[order_id])",
            "formatString": "0"
          },
          {
            "name": "Avg Order",
            "expression": [
              "DIVIDE(",
              "    [Total Sales],",
              "    [Order Count]",
              ")"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00"
          }
        ]
      },
      {
