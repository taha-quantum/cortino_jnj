      ],
      "sql": "SELECT SUM(s.amount) AS total_sales FROM analytics.sales s JOIN analytics.customers c ON s.customer_id = c.customer_id WHERE ($region IS NULL OR c.region = $region)",
      "params": [
        {
          "name": "region",
          "type": "string"
        }
      ],
      "columns": []
    },
    {
      "id": "sales_by_month",
      "visual_ids": [
        "lineSalesByMonth"
      ],
      "sql": "SELECT d.month, SUM(s.amount) AS total_sales FROM analytics.sales s JOIN analytics.customers c ON s.customer_id = c.customer_id JOIN analytics.dates d ON s.order_date = d.date WHERE ($region IS NULL OR c.region = $region) GROUP BY 1",
      "params": [
        {
          "name": "region",
          "type": "string"
        }
      ],
      "columns": []
    },
    {
      "id": "by_category",
      "visual_ids": [
        "tableByCategory"
      ],
      "sql": "SELECT p.category, SUM(s.amount) AS total_sales, COUNT(DISTINCT s.order_id) + COALESCE(MAX(CASE WHEN s.order_id IS NULL THEN 1 ELSE 0 END), 0) AS order_count FROM analytics.sales s JOIN analytics.customers c ON s.customer_id = c.customer_id JOIN analytics.products p ON s.product_id = p.product_id WHERE ($region IS NULL OR c.region = $region) GROUP BY 1",
      "params": [
        {
          "name": "region",
          "type": "string"
        }
      ],
      "columns": []
    }
