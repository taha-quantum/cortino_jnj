        "barSalesByRegion"
      ],
      "sql": "SELECT c.region, SUM(s.amount) AS total_sales FROM analytics.sales s JOIN analytics.customers c ON s.customer_id = c.customer_id WHERE ($region IS NULL OR c.region = $region) GROUP BY 1",
