table Sales
	lineageTag: cf639626-cec5-48b3-b231-4bd58f52bb13

	measure 'Total Sales' = SUM(Sales[amount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 244a35ca-535f-4b1e-b72c-7c9b288a3689

	measure 'Sales YTD' = TOTALYTD([Total Sales], 'Date'[date])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 5d0c1f9e-2b7a-4c1e-9a3f-1e6b7c8d9a01

	measure 'Sales LY' =
			CALCULATE(
			    [Total Sales],
			    SAMEPERIODLASTYEAR('Date'[date])
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 6e1d2a0f-3c8b-4d2f-8b4a-2f7c8d9e0b12

	measure '% of Total' =
			DIVIDE(
			    [Total Sales],
			    CALCULATE([Total Sales], ALL(Customer))
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7f2e3b1a-4d9c-4e3a-9c5b-3a8d9e0f1c23

	column order_id
		dataType: int64
		formatString: 0
		lineageTag: 6eb0b824-7a45-487a-a64c-57dc4df32289
		summarizeBy: none
		sourceColumn: order_id

		annotation SummarizationSetBy = Automatic

	column order_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: bef3ac50-44fa-4d39-a6d2-02f3a84ebf9f
		summarizeBy: none
