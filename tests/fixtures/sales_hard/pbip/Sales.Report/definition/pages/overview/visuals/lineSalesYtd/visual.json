{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "lineSalesYtd",
  "position": {
    "x": 20,
    "y": 300,
    "z": 2000,
    "height": 400,
    "width": 610,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "month"
                }
              },
              "queryRef": "Date.month",
              "nativeQueryRef": "month",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "year"
                }
              },
              "queryRef": "Date.year",
              "nativeQueryRef": "year",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Sales"
                    }
                  },
                  "Property": "Sales YTD"
                }
              },
              "queryRef": "Sales.Sales YTD",
              "nativeQueryRef": "Sales YTD"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
